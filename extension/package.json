{
  "name": "leetcomp",
  "displayName": "LeetComp",
  "version": "1.0.0",
  "description": "An AI that helps with personalized hints and calculates the time and space complexity of your code.",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.90.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "manifest": {
    "host_permissions": [
      "https://leetcode.com/*",
      "https://api.groq.com/*"
    ],
    "permissions": [
      "storage"
    ]
  }
}
